# ==========================================================================
# Código XR Capital
# Configuração para hospedagem Apache (Hostinger)
# ==========================================================================

# Página inicial
DirectoryIndex index.html

# Codificação padrão dos arquivos de texto
AddDefaultCharset UTF-8

# ==========================================================================
# ENDEREÇOS
# Tudo em mod_rewrite, na ordem certa. Misturar com o Redirect do mod_alias
# dá conflito, porque os dois módulos rodam em fases diferentes da requisição.
# ==========================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- 1. HTTPS ----------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---- 2. sem www --------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ---- 3. a home mora na raiz -------------------------------------------
  # /index.html, /index e /home levam para https://codigoxrcapital.com.br
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteRule ^home/?$ / [R=301,L]

  # ---- 4. páginas absorvidas pela one page de capital --------------------
  RewriteRule ^produtos-financeiros(\.html)?/?$ /capital#produtos [R=301,L,NE]
  RewriteRule ^home-cash(\.html)?/?$            /capital#home-cash [R=301,L,NE]

  # ---- 5. blog fora do ar ------------------------------------------------
  # A página continua no repositório, só não fica acessível enquanto não
  # houver artigo publicado. Para reativar, comente a linha abaixo.
  RewriteRule ^blog(\.html)?/?$ / [R=302,L]

  # ---- 6. endereço sem .html --------------------------------------------
  # quem chegar com .html é levado para a versão limpa
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # barra no fim atrapalha o caminho relativo dos assets
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ---- 7. serve /sobre a partir de sobre.html ---------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

# --------------------------------------------------------------------------
# Compressão
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

# --------------------------------------------------------------------------
# Cache
# HTML sempre revalidado, para publicar alteração e ver na hora.
# Fontes, imagens, CSS e JS ficam em cache longo.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                  "access plus 0 seconds"
  ExpiresByType text/css                   "access plus 6 months"
  ExpiresByType application/javascript     "access plus 6 months"
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType image/jpeg                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/svg+xml              "access plus 1 year"
  ExpiresByType image/x-icon               "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # cabeçalhos básicos de segurança
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Tipos MIME que nem todo servidor traz configurado
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# --------------------------------------------------------------------------
# Arquivos do repositório que não devem ficar acessíveis pela web.
# O deploy é feito por Git, então .git, notas internas e a configuração da
# Vercel acabam indo junto para a pasta do site.
# --------------------------------------------------------------------------
RedirectMatch 404 ^/\.git
# o IfModule evita erro 500 caso o servidor não tenha o módulo de autorização
<IfModule mod_authz_core.c>
  <FilesMatch "^\.|\.(md|json|yml|yaml)$">
    Require all denied
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Página de erro
# --------------------------------------------------------------------------
ErrorDocument 404 /index.html

# Impede a listagem de diretórios
Options -Indexes
